{
  "name": "panelprobe",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based display test patterns and calibration aids for OLED, IPS, and mobile screens.",
  "license": "MIT",
  "author": "CS Hari Krishna",
  "homepage": "https://csharikrishna.github.io/panelprobe/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csharikrishna/panelprobe.git"
  },
  "bugs": {
    "url": "https://github.com/csharikrishna/panelprobe/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "check": "node scripts/check.mjs",
    "test": "node scripts/smoke-test.mjs",
    "verify": "npm run lint && npm run check && npm run test",
    "social-card": "node scripts/build-social-card.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "puppeteer-core": "^25.10.0"
  },
  "keywords": [
    "display-test",
    "monitor-test",
    "oled",
    "dead-pixel",
    "screen-test",
    "calibration",
    "gamma",
    "backlight-bleed",
    "motion-blur",

    "canvas"
  ]
}
